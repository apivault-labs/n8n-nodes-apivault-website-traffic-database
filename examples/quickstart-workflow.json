    {
      "parameters": {
        "content": "## Setup\n1. Select your Apify API credential.\n2. Set traffic, country and category filters.\n3. The workflow assigns a simple outreach priority from the returned business signals.",
        "height": 260,
        "width": 440
      },
      "id": "d55d27c8-5665-5893-8b2e-5f8ba3b120de",
      "name": "How to use this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -220
      ]
    },
    {
      "parameters": {
        "workflow": "traffic",
        "minVisits": 10000,
        "onlyGrowing": true,
        "maxResults": 200,
        "sortBy": "visits",
        "sortOrder": "desc",
        "outputPreset": "outreach"
      },
      "id": "9c9705ed-0b23-5fb5-8c09-0d9d35ff7bdb",
      "name": "Find websites by traffic with Apify",
      "type": "n8n-nodes-apivault-website-traffic-database.websiteTrafficDatabase",
      "typeVersion": 1,
      "position": [
        260,
        120
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json; const visits = Number(j.latestMonthVisits ?? j.monthlyVisits ?? j.visits ?? 0); const growth = Number(j.monthlyGrowthPercent ?? j.growthPercent ?? 0); const priority = visits >= 100000 && growth > 0 ? 'high' : visits >= 10000 ? 'medium' : 'low'; return { json: { ...j, outreachPriority: priority, priorityReason: `${visits} estimated monthly visits; ${growth}% growth.` } };"
      },
      "id": "77d43f03-ee54-5c4c-950b-6f36983ed71f",
      "name": "Assign outreach priority",
      "type": "n8n-nodes-base.code",
